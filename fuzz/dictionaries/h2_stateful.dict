# Structured command opcodes and boundary values.
headers="\x00"
headers_continues="\x01"
continuation="\x02"
settings="\x03"
window_update="\x04"
reset="\x05"
ping="\x06"
unknown="\x07"
priority="\x08"
goaway="\x09"
data="\x0a"
push_promise="\x0b"
zero="\x00\x00\x00\x00"
window_max="\x7f\xff\xff\xff"
u32_max="\xff\xff\xff\xff"
