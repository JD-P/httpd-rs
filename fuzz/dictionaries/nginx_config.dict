"events { worker_connections 64; }"
"http {"
"server {"
"location = /exact {"
"location ^~ /assets/ {"
"location ~ '[.]php$' {"
"listen 127.0.0.1:18080 default_server;"
"server_name example.test *.example.test;"
"client_max_body_size 64k;"
"root /tmp;"
"alias /tmp/alias/;"
"index index.html index.htm;"
"try_files $uri $uri/ /index.html?$args;"
"error_page 404 /404.html;"
"expires modified 1h;"
"add_header X-Test value always;"
"gzip on;"
"gzip_comp_level 4;"
"gzip_vary on;"
"upstream app { server 127.0.0.1:19001; }"
"proxy_pass http://app/base/;"
"proxy_set_header Host $host;"
"proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
"proxy_connect_timeout 10s;"
"proxy_read_timeout 30s;"
"proxy_send_timeout 30s;"
"proxy_redirect off;"
"fastcgi_pass 127.0.0.1:19002;"
"fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;"
"fastcgi_index index.php;"
"fastcgi_split_path_info '^(.+[.]php)(/.+)$';"
"return 302 https://example.test/final;"
"include conf.d/*.conf;"
"httpd_rs_capability FastCgi On;"
"httpd_rs_capability UnstableFastCgiPaths On;"
