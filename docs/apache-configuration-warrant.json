      ]
    },
    {
      "id": "packaged-service-resource-ceilings",
      "family": "resource-ceilings",
      "classification": "generated-baseline",
      "product_action": "generated-default",
      "rationale": "The intrinsic request budgets are supplemented by process descriptor and task ceilings in systemd deployments.",
      "sources": [],
      "local_evidence": [
