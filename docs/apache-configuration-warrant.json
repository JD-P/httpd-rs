    {
      "id": "nextcloud-private-trees",
      "family": "application-private-data",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "Only the application knows that config, data and lib are private; these denies must not be generalized into Apache compatibility semantics.",
      "sources": [],
      "local_evidence": [
        {
          "layer": "deployment-config",
          "path": "tests/deployments/scenarios/nextcloud-fpm/driver.py",
          "contains": ["nextcloud_root / 'config'", "nextcloud_root / 'data'", "nextcloud_root / 'lib'", "Require all denied"]
        }
      ]
    },
    {
      "id": "bugzilla-source-nonpublication",
      "family": "application-source-execution",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "Bugzilla's private source suffixes and localconfig naming are application knowledge, not a generic server filename blacklist.",
      "sources": [],
      "local_evidence": [
        {
          "layer": "deployment-config",
          "path": "tests/deployments/scenarios/bugzilla-fastcgi/driver.py",
          "contains": ["(\\\\.pm|\\\\.pl|\\\\.tmpl|^localconfig.*)$", "Require all denied"]
        }
      ]
    },
    {
      "id": "wordpress-upload-script-deny",
      "family": "application-source-execution",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "WordPress permits writable uploads but must not execute PHP there; that relationship belongs to the application deployment policy.",
      "sources": [],
      "local_evidence": [
        {
          "layer": "deployment-config",
          "path": "tests/deployments/scenarios/wordpress-fpm/driver.py",
          "contains": ["wordpress_root / 'wp-content/uploads'", "<FilesMatch \"\\\\.php$\">", "Require all denied"]
        }
      ]
    }
  ]
