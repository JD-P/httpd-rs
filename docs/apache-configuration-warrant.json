{
  "schema": 1,
  "updated": "2026-11-13",
  "support_effect": "observation-only",
  "policy": "Configuration evidence creates review obligations only. It never adds an Apache directive, module, application, or compatibility claim to httpd-rs.",
  "classifications": {
    "intrinsic": "The product enforces the property even when the observed configuration guard is removed.",
    "generated-baseline": "Every configuration generated by this repository must emit the guard, while hand-written configurations remain operator responsibility.",
    "operator-owned": "The safe value depends on deployment or application semantics and must remain an explicit operator/application rule.",
    "irrelevant-unsupported": "The guarded feature is outside the supported surface and configuration attempting to enable it must be rejected."
  },
  "required_layers": [
    "apache-upstream",
    "debian",
    "ubuntu",
    "service-unit",
    "deployment-config"
  ],
  "required_families": [
    "filesystem-default-deny",
    "administrative-input-nonpublication",
    "administrative-handler-access",
    "resource-ceilings",
    "protocol-method-exposure",
    "dynamic-execution-islands",
    "forward-proxy-exposure",
    "transport-baseline",
    "service-sandbox",
    "application-private-data",
    "application-source-execution"
  ],
  "source_pins": {
