      "commit": "d827b05570e568e0afa068420c6f99afb253bda3"
    }
  },
  "guards": [
    {
      "id": "upstream-root-filesystem-deny",
      "family": "filesystem-default-deny",
      "classification": "generated-baseline",
      "product_action": "generated-default",
      "rationale": "A global deny is a useful migration baseline, but the set of content roots is deployment-specific.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/httpd.conf.in",
          "sha256": "15efcfb48e0047ff5e4a68f30233aea13b638e1ce3ac1799f52a12c0047e6a26",
          "contains": ["<Directory />", "AllowOverride none", "Require all denied"]
        }
      ],
      "local_evidence": [
        {
          "path": "tests/deployments/lib.py",
          "contains": ["<Directory />", "AllowOverride None", "Require all denied"]
        }
      ]
    },
    {
      "id": "upstream-administrative-file-deny",
      "family": "administrative-input-nonpublication",
      "classification": "intrinsic",
      "product_action": "implemented-invariant",
      "rationale": "Names are insufficient for custom AccessFileName and authentication databases; registered path and inode identity must be excluded at terminal local sinks.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/httpd.conf.in",
          "sha256": "15efcfb48e0047ff5e4a68f30233aea13b638e1ce3ac1799f52a12c0047e6a26",
          "contains": ["<Files \".ht*\">", "Require all denied"]
        }
      ],
      "local_evidence": [
        {
          "path": "crates/verified/src/lib.rs",
          "contains": ["administrative_input_sink_spec", "administrative_input_never_reaches_local_content_sink"]
        },
        {
          "path": "tests/adversarial_regressions.py",
          "contains": ["test_p39_registered_administrative_inputs_cannot_be_published", "test_p39_unregistered_dotfile_remains_ordinary_content"]
        },
        {
          "path": "tests/protocol_conformance.py",
          "contains": ["check_administrative_input_parity", "P39-H2-ACCESS-POLICY-SECRET"]
        }
      ]
    },
    {
      "id": "upstream-status-access-list",
      "family": "administrative-handler-access",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "The status handler is capability-gated, but the permitted client network is site-specific and must remain an explicit Require policy.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/extra/httpd-info.conf.in",
          "sha256": "c998ee1b26049571ed20dc89e7dd9d3e87e85846bdf0d9ff1aae9f760774bf5b",
          "contains": ["<Location /server-status>", "SetHandler server-status", "Require ip 127"]
        }
      ],
      "local_evidence": [
        {
          "path": "docs/reference/apache-compatibility.md",
          "contains": ["`ServerStatus`", "`server-info`"]
        }
      ]
    },
    {
      "id": "upstream-worker-ceiling",
      "family": "resource-ceilings",
      "classification": "intrinsic",
      "product_action": "implemented-invariant",
      "rationale": "Connection and worker admission requires a compiled upper bound even if an operator omits or inflates MaxRequestWorkers.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/extra/httpd-mpm.conf.in",
          "sha256": "eec0b9efa56e41ba96cc1d158e184e25b1157108bef510d37fcf6c1d37c76296",
          "contains": ["MaxRequestWorkers      250", "MaxRequestWorkers      400"]
        }
      ],
      "local_evidence": [
        {
          "path": "crates/server/src/config.rs",
          "contains": ["MAX_IMPLEMENTED_REQUEST_WORKERS", "MaxRequestWorkers exceeds ServerLimit"]
        }
      ]
    },
    {
      "id": "upstream-tls-protocol-floor",
      "family": "transport-baseline",
      "classification": "intrinsic",
      "product_action": "implemented-invariant",
      "rationale": "The rustls backend provides a closed modern protocol surface rather than inheriting an optional text snippet.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/extra/httpd-ssl.conf.in",
          "sha256": "e049098f4340ab52b9eaf8b88efb1b305fb965a8ea2ef9e700af86793e9ddd97",
          "contains": ["SSLProtocol all -SSLv3", "SSLProxyProtocol all -SSLv3"]
        }
      ],
      "local_evidence": [
        {
          "path": "docs/config-semantics.md",
          "contains": ["Rustls", "TLS"]
        }
      ]
    },
    {
      "id": "upstream-forward-proxy-off",
      "family": "forward-proxy-exposure",
      "classification": "irrelevant-unsupported",
      "product_action": "reject-unsupported",
      "rationale": "httpd-rs is a reverse proxy only; accepting ProxyRequests would silently create an unaudited authority surface.",
      "sources": [
        {
          "pin": "apache",
          "path": "docs/conf/extra/proxy-html.conf.in",
          "sha256": "9d70873703af389018ccc7b57a503d2692ba1d6b71271bcf00473d40f5095486",
          "contains": ["ProxyRequests Off  <-- this is an important security setting"]
        }
      ],
      "local_evidence": [
        {
          "path": "crates/server/src/config.rs",
          "contains": ["ProxyRequests On", "security family must fail closed"]
        },
        {
          "path": "docs/reference/apache-compatibility.md",
          "contains": ["forward proxying"]
        }
      ]
    },
    {
      "id": "debian-ubuntu-root-and-admin-denies",
      "family": "filesystem-default-deny",
      "classification": "generated-baseline",
      "product_action": "generated-default",
      "rationale": "The distribution baseline confirms that migration tooling must preserve an explicit root deny; administrative-input safety is additionally intrinsic under the separate guard.",
      "sources": [
        {
          "pin": "debian",
          "path": "debian/config-dir/apache2.conf.in",
          "sha256": "51831f3d92975f9fef26a8d5d8885752b41cded83ae268755dbe86b1d72c6bbf",
          "contains": ["<Directory />", "Require all denied", "<FilesMatch \"^\\.ht\">"]
        },
        {
          "pin": "ubuntu",
          "path": "debian/config-dir/apache2.conf.in",
          "sha256": "51831f3d92975f9fef26a8d5d8885752b41cded83ae268755dbe86b1d72c6bbf",
          "contains": ["<Directory />", "Require all denied", "<FilesMatch \"^\\.ht\">"]
        }
      ],
      "local_evidence": [
        {
          "path": "tests/deployments/lib.py",
          "contains": ["<Directory />", "Require all denied"]
        }
      ]
    },
    {
      "id": "debian-ubuntu-trace-off",
      "family": "protocol-method-exposure",
      "classification": "intrinsic",
      "product_action": "implemented-invariant",
      "rationale": "TRACE remains disabled by default and enabling it requires the independent process capability, so omission of the distro snippet cannot expose it.",
      "sources": [
        {
          "pin": "debian",
          "path": "debian/config-dir/conf-available/security.conf",
          "sha256": "86296f2324bcc27790a80c863886fffd10d7a48b28587151e541f38136055b8b",
          "contains": ["TraceEnable Off"]
        },
        {
          "pin": "ubuntu",
          "path": "debian/config-dir/conf-available/security.conf",
          "sha256": "86296f2324bcc27790a80c863886fffd10d7a48b28587151e541f38136055b8b",
          "contains": ["TraceEnable Off"]
        }
      ],
      "local_evidence": [
        {
          "path": "crates/server/src/config.rs",
          "contains": ["trace_enable: false", "Capability::Trace"]
        }
      ]
    },
    {
      "id": "debian-ubuntu-status-local",
      "family": "administrative-handler-access",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "Distribution defaults demonstrate the expected local-only posture; a non-local policy must be a visible deployment decision.",
      "sources": [
        {
          "pin": "debian",
          "path": "debian/config-dir/mods-available/status.conf",
          "sha256": "bd4009a7dca3d68c8f3d4c22dc549b4cbba0ec56fb5f3d82db6ba8ecb58cf589",
          "contains": ["SetHandler server-status", "Require local"]
        },
        {
          "pin": "ubuntu",
          "path": "debian/config-dir/mods-available/status.conf",
          "sha256": "bd4009a7dca3d68c8f3d4c22dc549b4cbba0ec56fb5f3d82db6ba8ecb58cf589",
          "contains": ["SetHandler server-status", "Require local"]
        }
      ],
      "local_evidence": [
        {
          "path": "tests/conformance.py",
          "contains": ["<Location \"/server-status\">", "SetHandler server-status"]
        }
      ]
    },
    {
      "id": "debian-ubuntu-cgi-island",
      "family": "dynamic-execution-islands",
      "classification": "operator-owned",
      "product_action": "operator-check",
      "rationale": "The executable directory and backend identity are deployment-specific; CGI is nevertheless default-off behind an explicit capability.",
      "sources": [
        {
          "pin": "debian",
          "path": "debian/config-dir/conf-available/serve-cgi-bin.conf",
          "sha256": "f3c96a2ec95fbb3371f2c18d77366fc09b07267a156beb4870943f3f029eb3f2",
          "contains": ["ScriptAlias /cgi-bin/ /usr/lib/cgi-bin/", "Options +ExecCGI -MultiViews +SymLinksIfOwnerMatch"]
        },
        {
          "pin": "ubuntu",
          "path": "debian/config-dir/conf-available/serve-cgi-bin.conf",
          "sha256": "f3c96a2ec95fbb3371f2c18d77366fc09b07267a156beb4870943f3f029eb3f2",
          "contains": ["ScriptAlias /cgi-bin/ /usr/lib/cgi-bin/", "Options +ExecCGI -MultiViews +SymLinksIfOwnerMatch"]
        }
      ],
      "local_evidence": [
        {
          "path": "docs/reference/apache-compatibility.md",
          "contains": ["`Cgi`", "`ScriptAlias`"]
        }
      ]
    },
    {
      "id": "packaged-service-sandbox",
      "family": "service-sandbox",
      "classification": "generated-baseline",
