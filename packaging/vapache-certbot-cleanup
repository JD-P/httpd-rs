#!/bin/sh -p
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset CDPATH ENV BASH_ENV
case "$0" in
    /usr/lib/vapache/*)
        vapache_cleanup_common=/usr/lib/vapache/control-common
        if [ -L "$vapache_cleanup_common" ] || [ ! -f "$vapache_cleanup_common" ] \
            || [ "$(stat -c '%u' -- "$vapache_cleanup_common")" != 0 ] \
            || [ -n "$(find "$vapache_cleanup_common" -maxdepth 0 -perm /022 -print -quit)" ]; then
            echo "vapache-certbot-cleanup: unsafe installed control library" >&2
            exit 1
        fi
        ;;
    *)
    case "$0" in
        */*) vapache_cleanup_script_dir=${0%/*} ;;
        *) vapache_cleanup_script_dir=. ;;
    esac
        vapache_cleanup_common=$vapache_cleanup_script_dir/vapache-control-common
        ;;
esac
. "$vapache_cleanup_common"

config_root=${VAPACHE_CERTBOT_CONFIG_ROOT:-/etc/letsencrypt}
shim=/usr/lib/vapache/certbot-apachectl
owner=$(id -u)
temporary=

cleanup_temporary() {
    vapache_cleanup_status=$?
    if [ -n "$temporary" ]; then
        rm -f -- "$temporary"
    fi
    return "$vapache_cleanup_status"
}
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup_temporary EXIT

if [ "$owner" -eq 0 ]; then
    case "$config_root" in
        /etc/letsencrypt|*/letsencrypt) ;;
        *)
            echo "vapache: refusing a privileged Certbot cleanup outside a dedicated letsencrypt root" >&2
            exit 1
            ;;
    esac
fi
if [ ! -e "$config_root" ] && [ ! -L "$config_root" ]; then
    exit 0
fi
config_root=$(vapache_canonical_unsymlinked "$config_root") || {
    echo "vapache: leaving unsafe Certbot configuration root untouched: $config_root" >&2
    exit 0
}
if [ ! -d "$config_root" ] || ! vapache_path_is_controlled "$config_root"; then
    echo "vapache: leaving unsafe Certbot configuration root untouched: $config_root" >&2
    exit 0
fi

clean_file() {
    file=$1
    kind=$2
    [ -e "$file" ] || return 0
    if [ -L "$file" ] || [ ! -f "$file" ] \
        || ! vapache_path_is_controlled "$file"; then
        echo "vapache: leaving unsafe Certbot configuration untouched: $file" >&2
        return 0
    fi

    temporary=$(mktemp "$file.vapache-remove.XXXXXX")
    case "$kind" in
        cli)
            awk -v value="$shim" '
                $0 ~ "^[[:space:]]*apache-ctl[[:space:]]*=[[:space:]]*" value "[[:space:]]*([#;].*)?$" { next }
                { print }
            ' "$file" >"$temporary"
            ;;
        renewal)
            awk -v value="$shim" '
                $0 ~ "^[[:space:]]*apache_ctl[[:space:]]*=[[:space:]]*" value "[[:space:]]*$" { next }
                { print }
            ' "$file" >"$temporary"
            ;;
        *)
            rm -f -- "$temporary"
            return 1
            ;;
    esac
    chown --reference="$file" "$temporary"
    chmod --reference="$file" "$temporary"
    mv -f -- "$temporary" "$file"
    temporary=
    if command -v restorecon >/dev/null 2>&1; then
        restorecon "$file" >/dev/null 2>&1 || true
    fi
}

clean_file "$config_root/cli.ini" cli
if [ -d "$config_root/renewal" ]; then
    if vapache_path_is_controlled "$config_root/renewal"; then
        for renewal in "$config_root"/renewal/*.conf; do
            [ -e "$renewal" ] || continue
            clean_file "$renewal" renewal
        done
    else
        echo "vapache: leaving unsafe Certbot renewal directory untouched" >&2
    fi
fi

hook=$config_root/renewal-hooks/deploy/vapache-reload
hook_parent=$config_root/renewal-hooks/deploy
if [ -d "$hook_parent" ] && ! vapache_path_is_controlled "$hook_parent"; then
    echo "vapache: leaving unsafe Certbot hook directory untouched" >&2
elif [ -L "$hook" ] && [ "$(readlink -- "$hook")" = /usr/lib/vapache/certbot-deploy-hook ]; then
    rm -f -- "$hook"
elif [ -e "$hook" ] || [ -L "$hook" ]; then
    echo "vapache: leaving non-Vapache Certbot hook untouched: $hook" >&2
fi
