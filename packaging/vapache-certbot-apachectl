#!/bin/sh
set -eu

vapache_control=${VAPACHE_CONTROL:-/usr/sbin/vapachectl}
systemctl_command=${VAPACHE_SYSTEMCTL:-systemctl}
target=${VAPACHE_CERTBOT_TARGET:-auto}

die() {
    echo "vapache-certbot-apachectl: $*" >&2
    exit 1
}

find_apache_control() {
    if [ -n "${VAPACHE_APACHECTL_DISCOVERY:-}" ]; then
        apache_control=$VAPACHE_APACHECTL_DISCOVERY
    elif [ -x /usr/sbin/apache2ctl ]; then
        apache_control=/usr/sbin/apache2ctl
    elif [ -x /usr/sbin/apachectl ]; then
        apache_control=/usr/sbin/apachectl
    else
        apache_control=
    fi
    if [ -n "$apache_control" ] && [ ! -x "$apache_control" ]; then
        die "Apache discovery control is not executable: $apache_control"
    fi
    if [ -n "$apache_control" ] && [ "$apache_control" -ef "$0" ]; then
        die "Apache discovery control resolves to this shim"
    fi
}

require_apache_control() {
    [ -n "$apache_control" ] || die \
        "the Certbot Apache plugin requires apache2ctl/apachectl for read-only configuration discovery"
}

vapache_is_active() {
    command -v "$systemctl_command" >/dev/null 2>&1 \
        && "$systemctl_command" is-active --quiet vapache.service 2>/dev/null
}

select_lifecycle_control() {
    case "$target" in
        vapache)
            lifecycle_target=vapache
            ;;
        apache)
            require_apache_control
            lifecycle_target=apache
            ;;
        auto)
            if vapache_is_active; then
                lifecycle_target=vapache
            else
                require_apache_control
                lifecycle_target=apache
            fi
            ;;
        *) die "VAPACHE_CERTBOT_TARGET must be auto, vapache, or apache" ;;
    esac
}

run_lifecycle() {
    action=$1
    select_lifecycle_control
    if [ "$lifecycle_target" = apache ]; then
        exec "$apache_control" "$action"
    fi
    [ -x "$vapache_control" ] || die \
        "Vapache control is not executable: $vapache_control"
    if vapache_is_active; then
        # The first certificate installation can enable a new privileged 443
        # listener. A post-drop graceful reload cannot bind that listener, so
        # use the service manager to create a fresh root-started generation.
        case "$action" in
            graceful|restart) exec "$systemctl_command" restart vapache.service ;;
            graceful-stop|stop) exec "$systemctl_command" stop vapache.service ;;
            start) exec "$systemctl_command" start vapache.service ;;
            status) exec "$systemctl_command" status vapache.service ;;
        esac
    fi
    exec "$vapache_control" "$action"
}

run_configtest() {
    # Certbot edits an Apache configuration, so retain Apache's syntax check
    # for its parser assumptions and then require Vapache to accept the same
    # result before Certbot is allowed to reload either daemon.
    require_apache_control
    "$apache_control" configtest
    case "$target" in
        vapache) exec "$vapache_control" configtest ;;
        apache) exit 0 ;;
        auto)
            if vapache_is_active; then
                exec "$vapache_control" configtest
            fi
            exit 0
            ;;
        *) die "VAPACHE_CERTBOT_TARGET must be auto, vapache, or apache" ;;
    esac
}

find_apache_control

[ "$#" -gt 0 ] || die "missing apachectl command"

case "$1" in
    -v|-V|-M|-S)
        [ "$#" -eq 1 ] || die "unsupported arguments: $*"
        require_apache_control
        exec "$apache_control" "$@"
        ;;
    configtest)
        [ "$#" -eq 1 ] || die "unsupported configtest arguments: $*"
        run_configtest
        ;;
    -t)
        if [ "$#" -eq 1 ]; then
            run_configtest
        fi
        if [ "$#" -eq 3 ] && [ "$2" = -D ]; then
            case "$3" in
                DUMP_MODULES|DUMP_INCLUDES|DUMP_RUN_CFG|DUMP_VHOSTS)
                    require_apache_control
                    exec "$apache_control" "$@"
                    ;;
            esac
        fi
        die "unsupported syntax-test arguments: $*"
        ;;
    graceful|restart)
        [ "$#" -eq 1 ] || die "unsupported lifecycle arguments: $*"
        run_lifecycle graceful
        ;;
    start|stop|graceful-stop|status)
        [ "$#" -eq 1 ] || die "unsupported lifecycle arguments: $*"
        run_lifecycle "$1"
        ;;
    -k)
        [ "$#" -eq 2 ] || die "unsupported lifecycle arguments: $*"
        case "$2" in
            graceful|restart)
                run_lifecycle graceful
                ;;
            start|stop|graceful-stop)
                run_lifecycle "$2"
                ;;
            *) die "unsupported lifecycle action: $2" ;;
        esac
        ;;
    *) die "unsupported apachectl command: $*" ;;
esac
