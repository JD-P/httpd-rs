#!/bin/sh -p
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset CDPATH ENV BASH_ENV
case "$0" in
    /usr/lib/vapache/*)
        vapache_certbot_common=/usr/lib/vapache/control-common
        if [ -L "$vapache_certbot_common" ] || [ ! -f "$vapache_certbot_common" ] \
            || [ "$(stat -c '%u' -- "$vapache_certbot_common")" != 0 ] \
            || [ -n "$(find "$vapache_certbot_common" -maxdepth 0 -perm /022 -print -quit)" ]; then
            echo "vapache-certbot-apachectl: unsafe installed control library" >&2
            exit 1
        fi
        ;;
    *)
    case "$0" in
        */*) vapache_certbot_script_dir=${0%/*} ;;
        *) vapache_certbot_script_dir=. ;;
    esac
        vapache_certbot_common=$vapache_certbot_script_dir/vapache-control-common
        ;;
esac
. "$vapache_certbot_common"

target=${VAPACHE_CERTBOT_TARGET:-auto}

die() {
    echo "vapache-certbot-apachectl: $*" >&2
    exit 1
}

vapache_control=$(vapache_validate_command \
    "${VAPACHE_CONTROL:-/usr/sbin/vapachectl}" vapachectl) \
    || die "Vapache control must be an unsymlinked, controlled vapachectl executable"

if [ -n "${VAPACHE_SYSTEMCTL:-}" ]; then
    systemctl_command=$(vapache_validate_command "$VAPACHE_SYSTEMCTL" systemctl) \
        || die "VAPACHE_SYSTEMCTL must be an unsymlinked, controlled systemctl executable"
elif systemctl_path=$(command -v systemctl 2>/dev/null); then
    systemctl_command=$(vapache_validate_command "$systemctl_path" systemctl) \
        || die "systemctl is not a controlled executable"
else
    systemctl_command=
fi

find_apache_control() {
    if [ -n "${VAPACHE_APACHECTL_DISCOVERY:-}" ]; then
        apache_control=$(vapache_validate_command \
            "$VAPACHE_APACHECTL_DISCOVERY" 'apachectl apache2ctl') \
            || die "Apache discovery control must be an unsymlinked, controlled apachectl executable"
    else
        apache_control=
        for apache_candidate in /usr/sbin/apache2ctl /usr/sbin/apachectl; do
            if apache_validated=$(vapache_validate_command \
                "$apache_candidate" 'apachectl apache2ctl' 2>/dev/null); then
                apache_control=$apache_validated
                break
            fi
        done
    fi
    if [ -n "$apache_control" ]; then
        if [ "$apache_control" -ef "$0" ]; then
            die "Apache discovery control resolves to this shim"
        fi
    fi
}

require_apache_control() {
    [ -n "$apache_control" ] || die \
        "the Certbot Apache plugin requires apache2ctl/apachectl for read-only configuration discovery"
}

vapache_is_active() {
    [ -n "$systemctl_command" ] \
        && "$systemctl_command" is-active --quiet vapache.service 2>/dev/null
}

select_lifecycle_control() {
    case "$target" in
        vapache)
            lifecycle_target=vapache
            ;;
        apache)
            require_apache_control
            lifecycle_target=apache
            ;;
        auto)
            if vapache_is_active; then
                lifecycle_target=vapache
            else
                require_apache_control
                lifecycle_target=apache
            fi
            ;;
        *) die "VAPACHE_CERTBOT_TARGET must be auto, vapache, or apache" ;;
    esac
}

run_lifecycle() {
    action=$1
    select_lifecycle_control
    if [ "$lifecycle_target" = apache ]; then
        exec "$apache_control" "$action"
    fi
    [ -x "$vapache_control" ] || die \
        "Vapache control is not executable: $vapache_control"
    if vapache_is_active; then
        # The first certificate installation can enable a new privileged 443
        # listener. A post-drop graceful reload cannot bind that listener, so
        # use the service manager to create a fresh root-started generation.
        case "$action" in
            graceful|restart) exec "$systemctl_command" restart vapache.service ;;
            graceful-stop|stop) exec "$systemctl_command" stop vapache.service ;;
            start) exec "$systemctl_command" start vapache.service ;;
            status) exec "$systemctl_command" status vapache.service ;;
        esac
    fi
    exec "$vapache_control" "$action"
}

run_configtest() {
    # Certbot edits an Apache configuration, so retain Apache's syntax check
    # for its parser assumptions and then require Vapache to accept the same
    # result before Certbot is allowed to reload either daemon.
    require_apache_control
    "$apache_control" configtest
    case "$target" in
        vapache) exec "$vapache_control" configtest ;;
        apache) exit 0 ;;
        auto)
            if vapache_is_active; then
                exec "$vapache_control" configtest
            fi
            exit 0
            ;;
        *) die "VAPACHE_CERTBOT_TARGET must be auto, vapache, or apache" ;;
    esac
}

find_apache_control

[ "$#" -gt 0 ] || die "missing apachectl command"

case "$1" in
    -v|-V|-M|-S)
        [ "$#" -eq 1 ] || die "unsupported arguments: $*"
        require_apache_control
        exec "$apache_control" "$@"
        ;;
    configtest)
        [ "$#" -eq 1 ] || die "unsupported configtest arguments: $*"
        run_configtest
        ;;
    -t)
        if [ "$#" -eq 1 ]; then
            run_configtest
        fi
        if [ "$#" -eq 3 ] && [ "$2" = -D ]; then
            case "$3" in
                DUMP_MODULES|DUMP_INCLUDES|DUMP_RUN_CFG|DUMP_VHOSTS)
                    require_apache_control
                    exec "$apache_control" "$@"
                    ;;
            esac
        fi
        die "unsupported syntax-test arguments: $*"
        ;;
    graceful|restart)
        [ "$#" -eq 1 ] || die "unsupported lifecycle arguments: $*"
        run_lifecycle graceful
        ;;
    start|stop|graceful-stop|status)
        [ "$#" -eq 1 ] || die "unsupported lifecycle arguments: $*"
        run_lifecycle "$1"
        ;;
    -k)
        [ "$#" -eq 2 ] || die "unsupported lifecycle arguments: $*"
        case "$2" in
            graceful|restart)
                run_lifecycle graceful
                ;;
            start|stop|graceful-stop)
                run_lifecycle "$2"
                ;;
            *) die "unsupported lifecycle action: $2" ;;
        esac
        ;;
    *) die "unsupported apachectl command: $*" ;;
esac
